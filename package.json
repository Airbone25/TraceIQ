    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^3.0.9"
  }
}
