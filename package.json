{
  "name": "traceiq",
  "version": "1.1.0",
  "description": "AI Database Investigation Agent",
  "author": "TraceIQ",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "electron electron/main.cjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder",
    "desktop:dist:win": "electron-builder --win --publish never",
    "desktop:dist:linux": "electron-builder --linux --publish never",
    "desktop:dist:mac": "electron-builder --mac --publish never",
    "desktop:publish": "electron-builder --win --publish always",
    "desktop:publish:all": "electron-builder -mwl --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:reset": "node scripts/reset-db.js",
    "db:setup-readonly": "node scripts/setup-readonly-user.js",
    "benchmark": "node scripts/benchmark.js",
    "eval": "node scripts/eval.js"
  },
  "files": [
    "electron/",
    "src/",
    "public/",
    "routes/",
    "controllers/",
    "database/",
    "config/",
    "agent/",
    "llm/",
    "middleware/",
    "scripts/",
    "security/",
    "services/",
    "sql/",
    "tools/",
    "utils/"
  ],
  "build": {
    "appId": "com.traceiq.desktop",
    "productName": "TraceIQ",
    "asar": false,
    "files": [
      "electron/**/*",
      ".env",
      "src/**/*",
      "public/**/*",
      "routes/**/*",
      "controllers/**/*",
      "database/**/*",
      "config/**/*",
      "agent/**/*",
      "llm/**/*",
      "middleware/**/*",
      "scripts/**/*",
      "security/**/*",
      "services/**/*",
      "sql/**/*",
      "tools/**/*",
      "utils/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Airbone25",
        "repo": "TraceIQ",
        "private": false
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TraceIQ"
    },
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "keywords": [
    "ai",
    "database",
    "investigation",
    "mysql"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Airbone25/TraceIQ.git"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "resend": "^6.25.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "supertest": "^7.2.2",
    "vitest": "^3.0.9"
  }
}
