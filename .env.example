# A non-empty global key is required for the server to boot; each user's own key
# is stored in MongoDB and overrides this per-request.
GROQ_API_KEY=
# Default model used by the investigation agent (not shown to end users).
GROQ_MODEL=openai/gpt-oss-120b
# Product data (users, Groq keys, saved connections, threads, investigations)
# lives in MongoDB. Any standard mongodb:// connection string works — local
# (mongodb://127.0.0.1:27017/traceiq) or remote.
# For any shared/remote host, enable MongoDB authentication and put the
# credentials in the URI, e.g. mongodb://USER:PASS@host:27017/traceiq. The
# default below is an open, no-auth instance for local development only —
# this store holds users' connection passwords and Groq keys, so do not use
# an unauthenticated MongoDB for real deployments.
MONGODB_URI=mongodb://127.0.0.1:27017/traceiq
# 64-character hex secret used to sign auth tokens and encrypt stored Groq keys
# and connection passwords. Generate with: openssl rand -hex 32
APP_SECRET=
# Optional: local MySQL used only for the bundled seed/initialisation scripts
# and evaluation harness (not for app data).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=traceiq
# Set to true for managed/hosted MySQL that requires TLS
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MAX_AGENT_STEPS=8
MAX_SQL_QUERIES=5
MAX_QUERY_ROWS=500
MAX_EXECUTION_TIME_MS=60000
MAX_QUERY_TIMEOUT_MS=30000
MAX_QUESTION_LENGTH=5000
LLM_MAX_TOKENS=1024
MAX_TOOL_RESULT_CHARS=4000
MAX_CONTEXT_CHARS=12000
MAX_CONCURRENT_INVESTIGATIONS=1
INVESTIGATION_QUEUE_TIMEOUT_MS=10000
THREAD_CONTEXT_TURNS=3
THREAD_CONTEXT_ANSWER_CHARS=2000
# --- Email verification (OTP via SMTP; Gmail app-password defaults) ---
# Leave SMTP_USER/SMTP_PASS empty for dev mode => the OTP is logged to the
# server console instead of emailed (useful for local testing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Whybase <keshavmehra2005@gmail.com>
EMAIL_OTP_TTL_MIN=15
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SEC=60
